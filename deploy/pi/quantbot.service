[Unit]
Description=Elrond quantbot paper-trading daemon
Documentation=https://github.com/jfhutchi/project_elrond
# The daemon reads market data and the broker API over the network. Starting before the network
# is up produces a first cycle that fails its own health checks for no real reason.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

# Restart rate limit. These belong in [Unit], not [Service] -- systemd silently ignores them
# there ("Unknown key 'StartLimitIntervalSec' in section [Service]"), which is where they were
# and why the limit was not in force on the first deployment.
#
# A daemon that fails on startup and restarts instantly forever hammers the broker API and gets
# the account rate-limited, turning a small fault into an outage. Five failures inside two
# minutes and systemd stops trying: a process that cannot start is something to investigate,
# not something to retry into the ground.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=__USER__
WorkingDirectory=__QUANTBOT_HOME__

# Credentials and paths live here, mode 600, outside the repo. Never in the unit file.
EnvironmentFile=/etc/quantbot/quantbot.env

__EXECSTART__

# Always restart, with five seconds between attempts. The ceiling on how many attempts is in
# [Unit] above, because that is the only section where systemd reads it.
Restart=always
RestartSec=5

# The Pi has no RTC and this process makes decisions on session boundaries. Fail loudly rather
# than trade against a wrong clock.
Environment=TZ=UTC

# The kill switch and the ledger are the safety mechanisms; keep the blast radius small anyway.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The ledger directory is the one place this needs to write.
ReadWritePaths=__QUANTBOT_DATA__

StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantbot

[Install]
WantedBy=multi-user.target
