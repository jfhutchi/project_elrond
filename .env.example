BROKER_PROVIDER=alpaca
TRADING_MODE=PAPER
BROKER_ENVIRONMENT=PAPER
EXPECTED_ACCOUNT_ID=

ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

LIVE_TRADING_ACKNOWLEDGED=false
KILL_SWITCH=true

MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_HEALTHY=false
BROKER_HEALTHY=false
RISK_ENGINE_HEALTHY=false
RECONCILIATION_SUCCESSFUL=false

# Runtime paths and provider choices (defaults shown).
QUANTBOT_CONFIG=config/strategy-v1.yaml
QUANTBOT_DB_PATH=quantbot.db
# The backend-neutral alternative (#196). Accepts sqlite:///<path> today. A postgresql:// URL is
# recognised and refused with BACKEND_NOT_ENABLED -- there is no host, no proven SQLite/PostgreSQL
# semantic parity (#197), and a connection string that parses is neither. Setting this AND
# QUANTBOT_DB_PATH is an error: inventing a precedence would make one of them silently do nothing.
# Never commit a URL containing userinfo or query-string credentials.
# QUANTBOT_DATABASE_URL=
QUANTBOT_LOCK_PATH=quantbot.lock
QUANTBOT_REPORTS_DIR=reports
QUANTBOT_MARKET_DATA_FEED=iex
QUANTBOT_MARKET_DATA_ADJUSTMENT=all
QUANTBOT_MAX_DATA_AGE_SECONDS=86400
QUANTBOT_GIT_COMMIT=

# Where mutable state lives -- databases, logs, datasets, models, the identity file. The paths
# above take priority when set, so a working installation is unaffected by leaving this alone.
# Unset falls back to a platform-appropriate location, which is why every default above is
# relative and therefore follows whichever directory the process started in.
# QUANTBOT_STATE_DIR=

# --------------------------------------------------------------------------------------------
# Research. Absent from this file until 2026-09-03, which made the research half of the system
# unconfigurable from the only document that says what to configure.
# --------------------------------------------------------------------------------------------
# The model runtime. `model_configuration()` raises ResearchNotConfigured without the first
# three, and `research-status` reports that as a state rather than an error -- research being
# unconfigured must not stop the trading system from answering. Any OpenAI-compatible
# /chat/completions endpoint: Ollama, LM Studio, llama.cpp, vLLM, or a hosted API.
# QUANTBOT_MODEL_ENDPOINT=http://127.0.0.1:11434/v1
# QUANTBOT_MODEL_GENERATOR=
# The critic must NOT be the generator, and naming the same model for both is refused: a model
# asked to review its own work at the one point nobody else reads the source is not a review.
# QUANTBOT_MODEL_CRITIC=
# Defaults to the generator when unset.
# QUANTBOT_MODEL_CODER=
# Only for hosted endpoints. A local runtime needs none, and this is never logged.
# QUANTBOT_MODEL_API_KEY=
# QUANTBOT_MODEL_CONTEXT_TOKENS=8192
# A critic given less context than the artifact it judges is reviewing an excerpt and reporting
# on the whole, so this is a floor rather than a preference.
# QUANTBOT_CRITIC_MIN_CONTEXT_TOKENS=8192

# SEC EDGAR sends an HTML 403 titled "Your Request Originates from an Undeclared Automated Tool"
# to any client that does not name a contact. Deliberately not defaulted -- a wrong contact is
# worse than none, because it names somebody who did not make the request.
# QUANTBOT_SEC_CONTACT=
